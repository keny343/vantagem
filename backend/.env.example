# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4200

# Local: docker-compose (5434) ou Postgres na máquina.
# Produção: Render Managed Postgres (ligação interna no mesmo região).
DATABASE_URL=postgresql://vantagem:vantagem_dev@localhost:5434/vantagem
DATABASE_SSL=false

# Origins allowed to call the API with credentials (comma-separated)
CORS_ORIGINS=http://localhost:5174

# Assinatura HMAC dos tokens CSRF (obrigatório em produção, mínimo 16 caracteres)
# CSRF_SECRET=gera-um-segredo-longo-e-aleatorio

SESSION_COOKIE_NAME=vantagem_session
LOG_LEVEL=info

# URL da loja (links de email e recuperação)
FRONTEND_URL=http://localhost:5174

# Admin inicial (só é criado se ainda não existir nenhum admin)
# ADMIN_EMAIL=admin@vantagem.ao
# ADMIN_PASSWORD=

# Email — sem SMTP o sistema só escreve no log
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=encomendas@vantagem.ao

# Fotos de produto e comprovativos — Supabase Storage (em produção é obrigatório)
# Produtos: URL pública. Comprovativos: objectos privados servidos só via API autenticada.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=artigos

# Pagamento = transferência bancária + comprovativo PDF + confirmação do admin.
# Não há API bancária nem referência Multibanco nesta fase.
# demo = ambiente de testes; producao = loja real (só admin/webhook confirma pagamento)
PAGAMENTO_MODO=producao
# PAGAMENTO_WEBHOOK_SECRET=

# Dados reais da empresa (IBAN obrigatório para o cliente transferir)
# LOJA_NOME_LEGAL=Vantagem Electrónica, Lda.
# LOJA_NIF=
# LOJA_IBAN=
# LOJA_EMAIL=encomendas@vantagem.ao
# LOJA_TELEFONE=+244 923 000 000
# LOJA_MORADA=Rua Rainha Ginga, Ingombota, Luanda

# Webhook opcional para erros 5xx (JSON POST). Ex.: Sentry Relay / Discord.
# ERROR_WEBHOOK_URL=
