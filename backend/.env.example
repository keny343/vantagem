# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4200

# Prefer a dedicated database. With docker-compose: port 5434 / user vantagem.
# If Docker Desktop is offline, a local Postgres role that can connect works too.
DATABASE_URL=postgresql://vantagem:vantagem_dev@localhost:5434/vantagem
# Aiven / Render Managed Postgres: set this to true
DATABASE_SSL=false

# Origins allowed to call the API with credentials (comma-separated)
CORS_ORIGINS=http://localhost:5174

SESSION_COOKIE_NAME=vantagem_session
LOG_LEVEL=info
